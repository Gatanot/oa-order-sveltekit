# adapter-node 监听设置
HOST=0.0.0.0
PORT=3000
# adapter-node 用于校验同源表单上传；按实际访问地址修改
ORIGIN=http://localhost:3000
# SQLite 文件路径；相对路径基于项目启动目录
DATABASE_PATH=./data/oa.db
# 请求体上限；需略高于附件接口的 10MB 单文件限制
BODY_SIZE_LIMIT=12582912
# Artifact 发布时使用的应用 id；本地开发可留空，此时身份状态为 unavailable
ARTIFACT_APP_ID=
# 身份网关默认使用 https://artifact.catsco.cc，通常无需覆盖
# ARTIFACT_GATEWAY_ORIGIN=https://artifact.catsco.cc

# AI 服务接口独立鉴权：留空则关闭，必须至少32字符且无空白。由管理员安全配置，勿提交真实值。
# 可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 在安全终端生成。
# 云端执行器使用同一密钥设置 X-OA-Agent-Key，不需要任何员工浏览器信息。
OA_AI_SERVICE_KEY=
# 稳定的服务Agent标识（1-64位字母数字下划线连字符）；密钥轮换时保持ID以保留幂等空间。
OA_AI_SERVICE_ID=shared-agent
OA_AI_SERVICE_NAME=OA代办Agent
