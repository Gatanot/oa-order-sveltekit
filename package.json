{
  "name": "oa-order-sveltekit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "基于 SvelteKit 的企业项目经营闭环工作台",
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run check && npm run build && npm run test:smoke",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "fflate": "^0.3.11",
    "lucide-svelte": "0.468.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.2.12",
    "@sveltejs/kit": "2.20.8",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@types/better-sqlite3": "7.6.13",
    "svelte": "5.28.2",
    "svelte-check": "4.1.7",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
