{
  "name": "oa-order-sveltekit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "基于 SvelteKit 的企业项目经营闭环工作台",
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/sync-pdfjs-assets.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "build": "vite build",
    "build:local": "vite build --config vite.local.config.ts",
    "start:local": "node build-local/server.js",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run check && npm run build && npm run build:local && npm run test:smoke && npm run test:ai",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:ai": "node --test scripts/ai-tool-host-test.mjs && node scripts/ai-current-user-test.mjs && node scripts/ai-orders-test.mjs",
    "seed:preview": "node scripts/seed-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "better-sqlite3": "11.10.0",
    "fflate": "^0.3.11",
    "lucide-svelte": "0.468.0",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.2.12",
    "@sveltejs/kit": "2.20.8",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@types/better-sqlite3": "7.6.13",
    "svelte": "5.28.2",
    "svelte-check": "4.1.7",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
